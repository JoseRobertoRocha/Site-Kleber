# Estas variaveis sao configuradas no dashboard do Vercel (Project Settings > Environment
# Variables), nao sao lidas de um arquivo .env em producao — o site nao tem build step.
# Use este arquivo so como referencia do que precisa ser criado. Veja SETUP.md.

# Cloudflare R2 (Account > R2 > bucket > Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Supabase (Project Settings > API) — mesmos valores usados em js/supabase-client.js
SUPABASE_URL=
SUPABASE_ANON_KEY=
